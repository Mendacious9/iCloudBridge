# 复制本文件为 keystore/keystore.properties，再填入你自己的签名信息。
#
#   cp keystore/keystore.properties.example keystore/keystore.properties
#
# keystore.properties 与 *.jks 都已被 .gitignore 排除 —— 签名密钥一旦泄露，
# 别人就能发布可以覆盖安装你 App 的包；一旦丢失，你就再也无法给已安装的
# App 推送升级，只能让用户卸载重装（登录态也会丢）。
#
# storeFile 是相对工程根目录的路径。

storeFile=keystore/icloudbridge-release.jks
storePassword=在这里填 jks 的密码
keyAlias=在这里填 key alias
keyPassword=在这里填 key 的密码
